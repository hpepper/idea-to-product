# Why is this file called Containerfile and not Dockerfile????????????

# Tool image of gui_editor (GEDT-AR-00034, T-54, T-60).
# Adds to the pinned official Rust image only these tools:
# cargo-audit, cargo-deny, clippy, rustfmt, and shellcheck.
# The image runs the supply-chain checks, the shellcheck gate, the build, and the tests;
# it is not a dev shell, and the GUI does not run in a container.
# container/tool_image.sh builds the image,
# tags it with the sha256 over this file and the base,
# and checks the base label and the tools before each use.
#
# The base is pinned by version tag and digest,
# so a retagged upstream image cannot change it.
# Update the tag and the digest together,
# and with them PINNED_RUST_IMAGE in container/tool_image.sh.
# tool_image.sh passes BASE_IMAGE only after checking that it is pinned the same way.
# TODO why is this pinned? how and when will it be updated?????
ARG BASE_IMAGE=docker.io/library/rust:1.100.0-trixie@sha256:223cc32ddca8f3ee90c436dbc94b6b5f052ea7f9653c5201e9612f08ad7d21b8
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
# tool_image.sh compares the digest in this label with the pinned digest before each use.
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

# --locked builds each tool from its own committed Cargo.lock.
# Removing the registry cache keeps the downloaded sources out of the image.
# TODO why are these version locked, who and when will they be updated? what about security findings in the versions?
RUN cargo install --locked --version 0.23.0 cargo-audit && rm -rf "$CARGO_HOME/registry"
RUN cargo install --locked --version 0.22.0 cargo-deny && rm -rf "$CARGO_HOME/registry"
# Both components follow the toolchain version of the pinned base.
RUN rustup component add clippy
RUN rustup component add rustfmt
# shellcheck comes from the Debian trixie archive of the base, which apt signature-checks,
# at the version that the release provides, with no version pin (GEDT-AR-00034).
# apt pulls only the runtime libraries of the package;
# --no-install-recommends adds nothing else.
# Removing the package lists keeps the archive index out of the image.
RUN apt-get update && apt-get install --yes --no-install-recommends shellcheck && rm -rf /var/lib/apt/lists/*
